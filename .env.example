# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# MED-06 : adresse bind (127.0.0.1 derrière un proxy Nginx, 0.0.0.0 sinon)
HOST=0.0.0.0

# Proxys PUBLICS placés devant celui de cette machine, séparés par des
# virgules (voir src/app.js). Le nginx local et la passerelle Docker sont déjà
# de confiance : cette liste ne sert qu'aux proxys joignables depuis Internet.
#
# Sans elle, toutes les requêtes venant du back-office KODAFRIK sont comptées
# sous l'adresse de SON serveur : un seul compteur anti-force-brute pour toute
# l'équipe, et le premier qui se trompe cinq fois verrouille les autres.
#
# N'y mettre QUE des proxys réellement administrés : toute adresse listée ici
# peut déclarer l'adresse du client qu'elle veut.
#   exemple : TRUST_PROXY_SUPPLEMENTAIRE=37.60.236.175
TRUST_PROXY_SUPPLEMENTAIRE=

# Déploiement Docker en production : port publié sur l'hôte, en loopback
# (docker-compose.prod.yml). Un VPS héberge souvent plusieurs API — figé à
# 3000, `docker compose up` échouait sur « port is already allocated » dès
# qu'une autre application l'occupait. Le port INTERNE du conteneur reste 3000
# quelle que soit cette valeur ; l'`upstream` de deploy/nginx.conf doit
# pointer sur la même.
# HOST_PORT=3000

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# Deux façons de la décrire ; DATABASE_URL gagne si elle est renseignée.
#
# 1) Hébergeur managé (Render, Railway, Neon…) : une seule chaîne, celle que
#    le tableau de bord vous donne. Recopier cinq valeurs à la main est le
#    meilleur moyen d'en fausser une.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/basededonnees
#
# 2) Docker Compose et développement local :
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saambiz
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# SSL vers la base. Exigé dès NODE_ENV=production, parce que les hébergeurs
# managés (Render, Railway, Neon…) le réclament. Un PostgreSQL local — en
# conteneur ou sur la même machine — n'a ni certificat ni SSL activé : le
# démarrage échoue alors sur « The server does not support SSL connections ».
#
# `false` lève l'exigence. À réserver à une base joignable uniquement par un
# réseau privé. docker-compose.prod.yml le pose déjà pour son service postgres,
# il n'y a rien à renseigner ici pour un déploiement Docker.
# DB_SSL=false

# Pool de connexions (facultatif). Chaque worker PM2 ouvre son propre pool :
# max × nombre de workers doit rester sous la limite de connexions de la base.
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_POOL_ACQUIRE_MS=30000
# DB_POOL_IDLE_MS=10000

# Performances (facultatif)
# Durée du cache mémoire des réglages (prix, version minimale, maintenance).
# CONFIG_CACHE_TTL_MS=60000
# Côté le plus long d'une image après envoi (redimensionnée par Cloudinary).
# UPLOAD_IMAGE_MAX_PX=1600

# ─── JWT — OBLIGATOIRE : minimum 32 caractères aléatoires ────────────────────
# Trois usages, trois secrets DISTINCTS. Le démarrage est refusé si deux
# portent la même valeur : un secret partagé entre l'accès et le
# rafraîchissement annule leur séparation — un jeton d'accès volé deviendrait
# utilisable pour se prolonger indéfiniment.
#
# En production, le démarrage est aussi refusé si l'un contient « change_me »,
# « exemple », « changeme »… : ces valeurs voyagent avec ce fichier.
#
# Pour en produire un : openssl rand -base64 48
JWT_SECRET=changez_ce_secret_par_une_chaine_aleatoire_de_min_32_chars
JWT_REFRESH_SECRET=autre_secret_refresh_min_32_chars_different_du_jwt_secret
# Facultatif en développement, EXIGÉ en production : sans lui, le serveur
# refuse de démarrer. Il manquait à ce fichier — d'où des déploiements qui
# échouaient au lancement sans que rien ne l'ait annoncé.
JWT_RESET_SECRET=troisieme_secret_reinitialisation_min_32_chars_encore_different
JWT_EXPIRES_IN=1h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Les trois interfaces web tournent sur 5188 (administration), 5190 (espace
# vendeur) et 5199 (site public + vitrines des boutiques). Le vendeur et le
# site public passent par un proxy Vite en développement et n'ont donc rien à
# déclarer ici ; en production, l'origine réelle du site doit y figurer, sinon
# les vitrines répondent par une erreur réseau sans message.
#
# La valeur ci-dessous reprend les trois ports réels du projet. Les ports 3000
# et 8080 qui traînaient ici ne sont ceux d'aucune des cinq applications :
# copié tel quel, ce fichier donnait un dashboard en erreur réseau dès le
# premier lancement en recette (NODE_ENV≠development).
CORS_ORIGIN=http://localhost:5188,http://localhost:5190,http://localhost:5199

# ─── Vitrines des boutiques ──────────────────────────────────────────────────
# Domaine qui sert les sites de boutique (saambiz.com/b/<slug>). Le vendeur voit
# cette adresse dans son tableau de bord, la partage sur WhatsApp et l'imprime
# sur ses cartes : elle est calculée côté serveur pour rester identique partout.
VITRINE_BASE_URL=https://saambiz.com

# Plafonds des deux seules routes publiques qui écrivent ou cherchent : le
# passage en caisse (par quart d'heure et par adresse IP) et le suivi de
# commande (par dix minutes). Les valeurs par défaut conviennent ; les baisser
# bloquerait les familles qui commandent depuis une connexion partagée.
# VITRINE_COMMANDE_RATE_LIMIT_MAX=10
# VITRINE_SUIVI_RATE_LIMIT_MAX=40

# L'assistant analyse le logo côté serveur (jimp) et téléverse l'original sur
# Cloudinary. Sans les clés CLOUDINARY_* ci-dessous, le site est tout de même
# créé — sans son logo — et la réponse porte `logoEnregistre: false`.

# ─── Cloudinary (upload images) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Orange Money ─────────────────────────────────────────────────────────────
ORANGE_CLIENT_ID=your_orange_client_id
ORANGE_CLIENT_SECRET=your_orange_client_secret
ORANGE_MERCHANT_KEY=your_merchant_key
ORANGE_RETURN_URL=https://your-domain.com/paiement/succes
ORANGE_CANCEL_URL=https://your-domain.com/paiement/annule
ORANGE_NOTIF_URL=https://your-domain.com/saambiz/paiement/webhook/orange

# URL API Orange Money — dev: .../dev/v1  |  prod: .../prod/v1
ORANGE_API_BASE=https://api.orange.com/orange-money-webpay/dev/v1

# HMAC secret pour vérifier les notifications webhook Orange Money (OBLIGATOIRE en prod)
ORANGE_WEBHOOK_SECRET=votre_secret_hmac_fourni_par_orange_money

# ─── Resend (emails transactionnels) ─────────────────────────────────────────
# Créer un compte sur https://resend.com et ajouter votre domaine vérifié
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse expéditrice (doit utiliser votre domaine vérifié sur Resend en prod)
MAIL_FROM=SaamBiz <noreply@send.saambiz.com>
# Pictogramme de l'en-tête des emails. Par défaut : <URL publique de l'API>/email/pictogramme.png
# (RENDER_EXTERNAL_URL sur Render, sinon API_PUBLIC_URL, sinon VITRINE_BASE_URL).
# API_PUBLIC_URL=https://api.saambiz.com
# MAIL_LOGO_URL=https://saambiz.com/email/pictogramme.png
# MAIL_REPLY_TO=support@saambiz.com

# ─── Firebase / FCM (notifications push) ─────────────────────────────────────
# Compte de service Firebase, obtenu ainsi :
#   Firebase Console → le projet saambiz-ca926 → ⚙ Paramètres du projet
#   → onglet « Comptes de service » → Générer une nouvelle clé privée
# Un fichier .json se télécharge. Il contient une clé privée : ne le versionnez
# jamais, ne le collez jamais dans un ticket ou un chat.
#
# TROIS FORMES sont acceptées. Par ORDRE DE PRÉFÉRENCE :
#
# 1) CHEMIN DU FICHIER — recommandé. Rien ne transite par l'environnement,
#    donc rien à échapper. Sur le VPS :
#       mkdir -p /var/www/saambiz-backend/deploy/secrets
#       # y déposer le .json téléchargé, puis :
#       chmod 600 /var/www/saambiz-backend/deploy/secrets/firebase-service-account.json
#    docker-compose.prod.yml monte ce dossier en lecture seule sur /app/secrets.
#    Le chemin ci-dessous est celui VU PAR LE CONTENEUR :
# FIREBASE_SERVICE_ACCOUNT_JSON=/app/secrets/firebase-service-account.json
#
# 2) BASE64 — une seule ligne, insensible aux retours à la ligne :
#       base64 -i firebase-service-account.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_JSON=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCi4uLg==
#
# 3) JSON BRUT sur une seule ligne. Fonctionne, mais c'est la forme qui casse
#    le plus souvent : la clé privée contient des `\n` qu'un éditeur ou un
#    copier-coller transforme en vraies lignes, et le JSON devient illisible.
#       jq -c . firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"saambiz-ca926",...}
#
# VOLONTAIREMENT COMMENTÉ, sans valeur d'exemple active : un gabarit de JSON
# aux champs remplis de « ... » se recopiait dans le .env tel quel, passait la
# lecture — les trois champs requis étaient présents —, et le serveur
# annonçait « Firebase Admin initialisé » avant de voir chaque envoi refusé.
# Mieux vaut la variable absente, que le journal signale clairement.
# Laisser vide ou commenté = notifications push désactivées, sans erreur.

# ─── Admin — OBLIGATOIRE pour npm run seed ────────────────────────────────────
# CRIT-01 : aucun fallback hardcodé — ces variables DOIVENT être définies
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=VotreMotDePasse_Min12Chars!

# ─── Réglages facultatifs ────────────────────────────────────────────────────
# Tous ont une valeur par défaut dans le code : les laisser commentés est le
# cas normal. Ils figurent ici parce qu'ils étaient lus par `config/security.js`
# sans être documentés nulle part — on ne règle pas ce qu'on ignore.

# Durées de vie des jetons.
# JWT_REFRESH_EXPIRES_IN vaut 3650d (10 ans) par défaut : il n'y a pas de
# déconnexion automatique. Le raccourcir rétablit une reconnexion forcée à
# l'échéance — garder alors REFRESH_DUREE_JOURS aligné sur cette valeur.
# JWT_REFRESH_EXPIRES_IN=3650d
# JWT_RESET_EXPIRES_IN=1h

# Sessions simultanées par compte. Au-delà, la plus ancienne est révoquée :
# un jeton volé ne survit donc pas indéfiniment à côté des sessions légitimes.
# REFRESH_MAX_PAR_UTILISATEUR=5
# REFRESH_DUREE_JOURS=3650

# Plafonds de requêtes. Inactifs hors production — un dashboard en
# développement fait beaucoup d'appels, doublés par React StrictMode.
# RATE_LIMIT_MAX=100
# Connexion : échecs seuls, par IP + identifiant, puis par IP toutes adresses.
# AUTH_RATE_LIMIT_MAX=10
# LOGIN_IP_RATE_LIMIT_MAX=50
# USER_RATE_LIMIT_MAX=60
# MUTATION_RATE_LIMIT_MAX=20
# Codes à usage unique : comptés sur l'adresse VISÉE, pas sur l'IP appelante.
# Sinon un attaquant qui fait tourner ses IP pilonne la boîte mail d'une
# victime sans jamais déclencher la limite.
# OTP_RATE_LIMIT_MAX=5
# Saisie d'un code reçu (échecs seuls), budget séparé de l'envoi.
# OTP_VERIFICATION_RATE_LIMIT_MAX=10

# Garde-fou : à `true` sur une instance joignable depuis internet, le
# démarrage est refusé tant que NODE_ENV≠production — donc tant que la
# limitation de débit est inactive. À n'activer que sur une recette exposée.
# EXPOSE_PUBLIQUEMENT=false

# Wave Checkout (https://docs.wave.com/checkout). Sans ces valeurs, le paiement
# Wave est refusé avec un message clair. URL de notification à déclarer :
# https://<domaine>/saambiz/v1/paiement/webhook/wave
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SUCCESS_URL=https://your-domain.com/paiement/succes
WAVE_ERROR_URL=https://your-domain.com/paiement/annule
# ─── Connexion Google / Apple (POST /auth/social) ────────────────────────────
# Identifiants OAuth Google acceptés, séparés par des virgules : le client iOS
# et le client « Application Web » (serverClientId) utilisé par Android.
# Google Cloud Console → API et services → Identifiants.
# Vide = connexion Google refusée par le serveur.
GOOGLE_CLIENT_IDS=
# Identifiants Apple acceptés (bundle iOS). Par défaut : com.saambiz.app
# APPLE_CLIENT_IDS=com.saambiz.app
