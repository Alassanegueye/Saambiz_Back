# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# MED-06 : adresse bind (127.0.0.1 derrière un proxy Nginx, 0.0.0.0 sinon)
HOST=0.0.0.0

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# Deux façons de la décrire ; DATABASE_URL gagne si elle est renseignée.
#
# 1) Hébergeur managé (Render, Railway, Neon…) : une seule chaîne, celle que
#    le tableau de bord vous donne. Recopier cinq valeurs à la main est le
#    meilleur moyen d'en fausser une.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/basededonnees
#
# 2) Docker Compose et développement local :
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saambiz
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ─── JWT — OBLIGATOIRE : minimum 32 caractères aléatoires ────────────────────
# Trois usages, trois secrets DISTINCTS. Le démarrage est refusé si deux
# portent la même valeur : un secret partagé entre l'accès et le
# rafraîchissement annule leur séparation — un jeton d'accès volé deviendrait
# utilisable pour se prolonger indéfiniment.
#
# En production, le démarrage est aussi refusé si l'un contient « change_me »,
# « exemple », « changeme »… : ces valeurs voyagent avec ce fichier.
#
# Pour en produire un : openssl rand -base64 48
JWT_SECRET=changez_ce_secret_par_une_chaine_aleatoire_de_min_32_chars
JWT_REFRESH_SECRET=autre_secret_refresh_min_32_chars_different_du_jwt_secret
# Facultatif en développement, EXIGÉ en production : sans lui, le serveur
# refuse de démarrer. Il manquait à ce fichier — d'où des déploiements qui
# échouaient au lancement sans que rien ne l'ait annoncé.
JWT_RESET_SECRET=troisieme_secret_reinitialisation_min_32_chars_encore_different
JWT_EXPIRES_IN=1h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Les trois interfaces web tournent sur 5188 (administration), 5190 (espace
# vendeur) et 5199 (site public + vitrines des boutiques). Le vendeur et le
# site public passent par un proxy Vite en développement et n'ont donc rien à
# déclarer ici ; en production, l'origine réelle du site doit y figurer, sinon
# les vitrines répondent par une erreur réseau sans message.
#
# La valeur ci-dessous reprend les trois ports réels du projet. Les ports 3000
# et 8080 qui traînaient ici ne sont ceux d'aucune des cinq applications :
# copié tel quel, ce fichier donnait un dashboard en erreur réseau dès le
# premier lancement en recette (NODE_ENV≠development).
CORS_ORIGIN=http://localhost:5188,http://localhost:5190,http://localhost:5199

# ─── Vitrines des boutiques ──────────────────────────────────────────────────
# Domaine qui sert les sites de boutique (saambiz.com/b/<slug>). Le vendeur voit
# cette adresse dans son tableau de bord, la partage sur WhatsApp et l'imprime
# sur ses cartes : elle est calculée côté serveur pour rester identique partout.
VITRINE_BASE_URL=https://saambiz.com

# Plafonds des deux seules routes publiques qui écrivent ou cherchent : le
# passage en caisse (par quart d'heure et par adresse IP) et le suivi de
# commande (par dix minutes). Les valeurs par défaut conviennent ; les baisser
# bloquerait les familles qui commandent depuis une connexion partagée.
# VITRINE_COMMANDE_RATE_LIMIT_MAX=10
# VITRINE_SUIVI_RATE_LIMIT_MAX=40

# L'assistant analyse le logo côté serveur (jimp) et téléverse l'original sur
# Cloudinary. Sans les clés CLOUDINARY_* ci-dessous, le site est tout de même
# créé — sans son logo — et la réponse porte `logoEnregistre: false`.

# ─── Cloudinary (upload images) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Orange Money ─────────────────────────────────────────────────────────────
ORANGE_CLIENT_ID=your_orange_client_id
ORANGE_CLIENT_SECRET=your_orange_client_secret
ORANGE_MERCHANT_KEY=your_merchant_key
ORANGE_RETURN_URL=https://your-domain.com/paiement/succes
ORANGE_CANCEL_URL=https://your-domain.com/paiement/annule
ORANGE_NOTIF_URL=https://your-domain.com/saambiz/paiement/webhook/orange

# URL API Orange Money — dev: .../dev/v1  |  prod: .../prod/v1
ORANGE_API_BASE=https://api.orange.com/orange-money-webpay/dev/v1

# HMAC secret pour vérifier les notifications webhook Orange Money (OBLIGATOIRE en prod)
ORANGE_WEBHOOK_SECRET=votre_secret_hmac_fourni_par_orange_money

# ─── Resend (emails transactionnels) ─────────────────────────────────────────
# Créer un compte sur https://resend.com et ajouter votre domaine vérifié
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adresse expéditrice (doit utiliser votre domaine vérifié sur Resend en prod)
MAIL_FROM=SaamBiz <noreply@votre-domaine.com>

# ─── Firebase / FCM (notifications push) ─────────────────────────────────────
# Coller le JSON complet du service account Firebase (sur une seule ligne, échappé)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ─── Admin — OBLIGATOIRE pour npm run seed ────────────────────────────────────
# CRIT-01 : aucun fallback hardcodé — ces variables DOIVENT être définies
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=VotreMotDePasse_Min12Chars!

# ─── Réglages facultatifs ────────────────────────────────────────────────────
# Tous ont une valeur par défaut dans le code : les laisser commentés est le
# cas normal. Ils figurent ici parce qu'ils étaient lus par `config/security.js`
# sans être documentés nulle part — on ne règle pas ce qu'on ignore.

# Durées de vie des jetons.
# JWT_REFRESH_EXPIRES_IN=7d
# JWT_RESET_EXPIRES_IN=1h

# Sessions simultanées par compte. Au-delà, la plus ancienne est révoquée :
# un jeton volé ne survit donc pas indéfiniment à côté des sessions légitimes.
# REFRESH_MAX_PAR_UTILISATEUR=5
# REFRESH_DUREE_JOURS=7

# Plafonds de requêtes. Inactifs hors production — un dashboard en
# développement fait beaucoup d'appels, doublés par React StrictMode.
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10
# USER_RATE_LIMIT_MAX=60
# MUTATION_RATE_LIMIT_MAX=20
# Codes à usage unique : comptés sur l'adresse VISÉE, pas sur l'IP appelante.
# Sinon un attaquant qui fait tourner ses IP pilonne la boîte mail d'une
# victime sans jamais déclencher la limite.
# OTP_RATE_LIMIT_MAX=5

# Garde-fou : à `true` sur une instance joignable depuis internet, le
# démarrage est refusé tant que NODE_ENV≠production — donc tant que la
# limitation de débit est inactive. À n'activer que sur une recette exposée.
# EXPOSE_PUBLIQUEMENT=false
