{
  "name": "saambiz_backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node -r dotenv/config src/seed/runSeed.js",
    "migrate": "node src/seed/migrate.js",
    "seed:menus": "node src/seed/seedMenus.js",
    "seed:categories": "node -r dotenv/config src/seed/seedCategories.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop saambiz-backend",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production --update-env",
    "pm2:logs": "pm2 logs saambiz-backend",
    "pm2:status": "pm2 status saambiz-backend",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f backend",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "backup": "bash deploy/backup-postgres.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.1.0",
    "jimp": "^1.6.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.12.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  }
}
